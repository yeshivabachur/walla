      "type": "string"
    },
    "monthly_budget": {
      "type": "number"
    },
    "spent_this_month": {
      "type": "number"
    },
    "alert_threshold": {
      "type": "number"
    },
    "auto_pause_when_exceeded": {
      "type": "boolean"
    }
  },
