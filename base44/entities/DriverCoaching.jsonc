{
  "name": "DriverCoaching",
  "type": "object",
  "properties": {
    "driver_email": {
      "type": "string"
    },
    "coaching_date": {
      "type": "string",
      "format": "date"
    },
    "focus_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "improvement_plan": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "progress_score": {
      "type": "number"
    }
  },
  "required": [
    "driver_email"
  ]
}