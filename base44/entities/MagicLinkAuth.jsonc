{
  "name": "MagicLinkAuth",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "link_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean"
    }
  },
  "required": [
    "user_email"
  ]
}