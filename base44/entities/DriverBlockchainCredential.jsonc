{
  "name": "DriverBlockchainCredential",
  "type": "object",
  "properties": {
    "driver_email": {
      "type": "string"
    },
    "credential_hash": {
      "type": "string"
    },
    "verifications": {
      "type": "number"
    },
    "trust_tokens": {
      "type": "number"
    }
  },
  "required": [
    "driver_email"
  ]
}