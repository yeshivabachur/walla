      "type": "number"
    },
    "maintenance_costs": {
      "type": "number"
    },
    "insurance_costs": {
      "type": "number"
    },
    "other_expenses": {
      "type": "number"
    },
    "total_expenses": {
      "type": "number"
    },
    "net_earnings": {
      "type": "number"
    },
    "profit_margin": {
      "type": "number"
    }
  },
