{
  "name": "CarpoolMatch",
  "type": "object",
  "properties": {
    "primary_passenger_email": {
      "type": "string"
    },
    "matched_passenger_email": {
      "type": "string"
    },
    "route_similarity_score": {
      "type": "number"
    },
    "shared_route": {
      "type": "string"
    },
    "cost_savings_per_person": {
      "type": "number"
    },
    "match_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "completed"
      ]
    },
    "environmental_impact": {
      "type": "number"
    }
  },
  "required": [
    "primary_passenger_email",
    "matched_passenger_email"
  ]
}