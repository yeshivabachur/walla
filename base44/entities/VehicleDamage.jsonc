{
  "name": "VehicleDamage",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "ride_request_id": {
      "type": "string"
    },
    "damage_type": {
      "type": "string",
      "enum": [
        "minor_scratch",
        "dent",
        "broken_window",
        "interior_damage",
        "major"
      ]
    },
    "description": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_cost": {
      "type": "number"
    },
    "reported_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "vehicle_id",
    "driver_email",
    "damage_type"
  ]
}