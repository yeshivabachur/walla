{
  "name": "RideCheckIn",
  "type": "object",
  "properties": {
    "ride_request_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "safe",
        "needs_attention",
        "emergency"
      ]
    },
    "location": {
      "type": "object"
    },
    "response_required": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "ride_request_id",
    "user_email",
    "status"
  ]
}