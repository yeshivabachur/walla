{
  "name": "AirportQueue",
  "type": "object",
  "properties": {
    "airport_code": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "queue_position": {
      "type": "number"
    },
    "estimated_wait_minutes": {
      "type": "number"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "called",
        "completed"
      ]
    }
  },
  "required": [
    "airport_code",
    "driver_email"
  ]
}