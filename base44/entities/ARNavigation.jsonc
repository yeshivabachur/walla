{
  "name": "ARNavigation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "ar_enabled": {
      "type": "boolean",
      "default": false
    },
    "ar_preferences": {
      "type": "object",
      "properties": {
        "overlay_style": {
          "type": "string",
          "enum": [
            "minimal",
            "detailed",
            "immersive"
          ],
          "default": "detailed"
        },
        "poi_display": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": [
    "user_email"
  ]
}