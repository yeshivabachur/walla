      "type": "string"
    },
    "target_email": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "categories": {
      "type": "object",
      "properties": {
        "punctuality": {
          "type": "number"
        },
        "cleanliness": {
          "type": "number"
        },
        "communication": {
          "type": "number"
        },
        "safety": {
