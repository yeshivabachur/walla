{
  "name": "SafetyCheckIn",
  "type": "object",
  "properties": {
    "ride_request_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "needs_help",
        "emergency"
      ],
      "default": "ok"
    },
    "response_required": {
      "type": "boolean",
      "default": false
    },
    "responded": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "ride_request_id",
    "user_email"
  ]
}