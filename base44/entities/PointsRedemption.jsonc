{
  "name": "PointsRedemption",
  "type": "object",
  "properties": {
    "passenger_email": {
      "type": "string"
    },
    "points_redeemed": {
      "type": "number"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "discount",
        "free_ride",
        "upgrade",
        "partner_offer"
      ]
    },
    "reward_value": {
      "type": "number"
    },
    "redemption_date": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "passenger_email",
    "points_redeemed",
    "reward_type"
  ]
}