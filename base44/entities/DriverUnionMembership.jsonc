    "driver_email": {
      "type": "string"
    },
    "union_name": {
      "type": "string"
    },
    "membership_status": {
      "type": "string"
    },
    "monthly_dues": {
      "type": "number"
    },
    "benefits_active": {
      "type": "boolean"
    }
