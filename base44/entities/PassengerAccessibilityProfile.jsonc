{
  "name": "PassengerAccessibilityProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "visual_impairment": {
      "type": "boolean"
    },
    "hearing_impairment": {
      "type": "boolean"
    },
    "mobility_impairment": {
      "type": "boolean"
    },
    "assistance_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_email"
  ]
}