{
  "name": "PassengerGroup",
  "type": "object",
  "properties": {
    "group_name": {
      "type": "string"
    },
    "admin_email": {
      "type": "string"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "shared_payment": {
      "type": "boolean",
      "default": false
    },
    "group_discount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "group_name",
    "admin_email"
  ]
}