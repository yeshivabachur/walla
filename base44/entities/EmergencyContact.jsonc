      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "default": 1
    },
    "auto_notify": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
