{
  "name": "LoyaltyPoints",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze"
    },
    "points_earned_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "points_redeemed_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "lifetime_points": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email"
  ]
}