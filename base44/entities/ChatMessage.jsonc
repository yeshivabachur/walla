{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "ride_request_id": {
      "type": "string",
      "description": "ID of the ride request"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "passenger",
        "driver"
      ],
      "description": "Type of sender"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    }
  },
  "required": [
    "ride_request_id",
    "sender_email",
    "sender_name",
    "sender_type",
    "message"
  ]
}