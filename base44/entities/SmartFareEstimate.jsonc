{
  "name": "SmartFareEstimate",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "estimated_fare": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "origin",
    "destination"
  ]
}