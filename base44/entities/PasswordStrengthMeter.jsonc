{
  "name": "PasswordStrengthMeter",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "password_strength": {
      "type": "string",
      "enum": [
        "weak",
        "fair",
        "good",
        "strong"
      ]
    },
    "entropy_bits": {
      "type": "number"
    }
  },
  "required": [
    "user_email"
  ]
}