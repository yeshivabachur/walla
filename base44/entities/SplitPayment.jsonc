{
  "name": "SplitPayment",
  "type": "object",
  "properties": {
    "ride_request_id": {
      "type": "string"
    },
    "total_amount": {
      "type": "number"
    },
    "split_method": {
      "type": "string",
      "enum": [
        "equal",
        "custom",
        "percentage"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "paid": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "completed"
      ],
      "default": "pending"
    },
    "payment_deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "ride_request_id",
    "total_amount",
    "participants"
  ]
}