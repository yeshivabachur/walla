{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "achievement_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "unlocked": {
      "type": "boolean",
      "default": false
    },
    "unlocked_date": {
      "type": "string",
      "format": "date-time"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "target": {
      "type": "number"
    },
    "points_reward": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "achievement_id",
    "name"
  ]
}