{
  "name": "PasswordPolicy",
  "type": "object",
  "properties": {
    "min_length": {
      "type": "number"
    },
    "require_uppercase": {
      "type": "boolean"
    },
    "require_lowercase": {
      "type": "boolean"
    },
    "require_numbers": {
      "type": "boolean"
    },
    "require_special_chars": {
      "type": "boolean"
    },
    "expiry_days": {
      "type": "number"
    }
  },
  "required": [
    "min_length"
  ]
}