  "name": "FailoverConfiguration",
  "type": "object",
  "properties": {
    "primary_server": {
      "type": "string"
    },
    "backup_server": {
      "type": "string"
    },
    "automatic_failover": {
      "type": "boolean"
    },
    "failover_time_seconds": {
      "type": "number"
    }
  },
