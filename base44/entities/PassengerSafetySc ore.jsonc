{
  "name": "PassengerSafetySc ore",
  "type": "object",
  "properties": {
    "passenger_email": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "default": 100,
      "description": "Safety score out of 100"
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "positive_behaviors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "passenger_email"
  ]
}