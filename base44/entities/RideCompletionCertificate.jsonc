{
  "name": "RideCompletionCertificate",
  "type": "object",
  "properties": {
    "ride_request_id": {
      "type": "string"
    },
    "certificate_url": {
      "type": "string"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time"
    },
    "verification_code": {
      "type": "string"
    }
  },
  "required": [
    "ride_request_id"
  ]
}