{
  "name": "PasswordlessAuth",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "magic_link",
        "otp",
        "biometric"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "user_email",
    "method"
  ]
}