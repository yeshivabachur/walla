{
  "name": "PromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Promo code string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed",
        "free_ride"
      ],
      "description": "Type of discount"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount amount or percentage"
    },
    "max_uses": {
      "type": "number",
      "default": 1,
      "description": "Maximum number of times code can be used"
    },
    "used_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times code has been used"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Expiration date"
    },
    "min_fare": {
      "type": "number",
      "default": 0,
      "description": "Minimum fare required to use code"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether code is currently active"
    },
    "user_specific": {
      "type": "string",
      "description": "Email of specific user (if applicable)"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ]
}